<?xml version="1.0"?>
<ruleset name="woo-subscription-trial-coupon">
    <description>WordPress standards; existing findings are tracked in phpcs-baseline.json.</description>
    <file>woo-subscription-trial-coupon.php</file>
    <file>Classes/</file>
    <file>uninstall.php</file>
    <arg name="extensions" value="php"/>
    <arg name="colors"/>
    <config name="testVersion" value="7.0-"/>
    <rule ref="WordPress"/>
    <rule ref="PHPCompatibilityWP"/>
</ruleset>
