{
  "name": "woo-subscription-trial-coupon",
  "version": "2.0.3",
  "private": true,
  "description": "Development and test tooling for Woo Subscription Trial Coupon",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "env:start": "wp-env --config=.wp-env.subscriptions.json start",
    "env:stop": "wp-env --config=.wp-env.subscriptions.json stop",
    "env:logs": "wp-env --config=.wp-env.subscriptions.json logs",
    "wp": "wp-env --config=.wp-env.subscriptions.json run cli wp",
    "test:php": "node scripts/test-php.mjs",
    "test:tooling": "node --test tests/node/*.test.mjs",
    "woo:status": "node scripts/woocommerce-version.mjs status",
    "woo:use": "node scripts/woocommerce-version.mjs use",
    "woo:backup": "node scripts/woocommerce-version.mjs backup",
    "woo:snapshots": "node scripts/woocommerce-version.mjs snapshots",
    "woo:restore": "node scripts/woocommerce-version.mjs restore",
    "test:setup": "node scripts/setup-e2e.mjs",
    "test:e2e": "node scripts/run-e2e.mjs",
    "test:e2e:ui": "node scripts/run-e2e.mjs --ui",
    "test:e2e:integration": "node scripts/run-e2e.mjs --subscriptions --require-premium --grep @premium",
    "build": "node scripts/build.mjs",
    "check:release": "node scripts/check-release.mjs",
    "demo:seed": "node scripts/seed-demo.mjs",
    "demo:refresh": "node scripts/seed-demo.mjs --refresh",
    "demo:subscriptions": "node scripts/seed-demo.mjs --subscriptions",
    "test:e2e:subscriptions": "node scripts/run-e2e.mjs --subscriptions --require-premium",
    "test:release": "node scripts/test-release.mjs",
    "verify": "node scripts/verify.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@wordpress/env": "12.0.0"
  },
  "overrides": {
    "qs": "6.16.0"
  }
}
